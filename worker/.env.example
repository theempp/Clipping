# Copy to C:\clip-work\worker\.env on the PC. Never commit the real file.
CLIP_WORK_DIR=C:\clip-work
CLIP_CHANNELS_FILE=config\channels.toml
CLIP_WORKER_ID=pc-main

# Supabase (service role key: PC only, never in the dashboard or the vault)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Grok judge: cheapest model that passes the labeled eval set
XAI_API_KEY=
GROK_MODEL=
GROK_PRICE_IN_PER_MTOK=
GROK_PRICE_OUT_PER_MTOK=

# Twitch app (client credentials, live status only; chat is anonymous)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick app (live status). Chat: KICK_PUSHER_KEY = public key used by Kick's web chat (unofficial path)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_PUSHER_KEY=

# Posting accounts. Prefix = destinations.credential_ref in Supabase.
# YouTube (Google OAuth client, scope youtube.upload)
YT_MAIN_CLIENT_ID=
YT_MAIN_CLIENT_SECRET=
YT_MAIN_REFRESH_TOKEN=
# X (OAuth 2.0 user context: tweet.write users.read media.write offline.access)
X_MAIN_CLIENT_ID=
X_MAIN_CLIENT_SECRET=
X_MAIN_REFRESH_TOKEN=

# Discord campaign watcher (own bot, own server; Message Content intent on)
DISCORD_BOT_TOKEN=
DISCORD_CAMPAIGN_CHANNEL_ID=

# Tool paths if not on PATH
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
STREAMLINK_BIN=streamlink
