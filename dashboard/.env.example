# Copy to .env.local and fill in. Never commit the real file.
# Leave both Supabase values empty (or set CLIPP_DEMO=1) to run the demo with sample clips.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 1 = force demo mode even when Supabase values are set.
NEXT_PUBLIC_CLIPP_DEMO=
# Name shown for the PC in the dashboard.
NEXT_PUBLIC_PC_NAME=Daddys

# ---- Server-only (live numbers, /api/live). No NEXT_PUBLIC_ prefix: never sent to the browser.
# Each platform is optional; a missing pair shows "key not set" for that source.
# Writes live_stats / stat_snapshots. Server env only (hosting dashboard or .env.local), never client code.
SUPABASE_SERVICE_ROLE_KEY=
# Lets a scheduler call POST /api/live with "Authorization: Bearer <value>".
CRON_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
X_BEARER_TOKEN=
X_USERNAME=
# TikTok numbers stay manual until the API audit.
